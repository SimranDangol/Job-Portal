{
  "compilerOptions": {
    "jsx": "react-jsx",         
    "moduleResolution": "node", 
    "strict": true,             
    "esModuleInterop": true,    
    "skipLibCheck": true,       
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}
